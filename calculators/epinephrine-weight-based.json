  "compute": {
    "engine": "expr",
    "steps": [
      {
        "key": "concentration_value_v2",
        "expr": "((concentration) / 1000) if (concentration != 'other') else ((drug_amount * 1000) / infusate_volume)"
      },
      {
        "key": "concentration_rate_result",
        "expr": "((round((((dose) * (weight) * 60) / (((1000) if ((concentration) != 'other') else (1))) / (concentration_value_v2)), 2)))"

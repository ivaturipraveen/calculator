  "compute": {
    "engine": "expr",
    "steps": [
      {
        "key": "concentration_calc_v2",
        "expr": "(drug_amount / infusate_volume) if (concentration == 'other') else ((concentration))"
      },
      {
        "key": "rate_v2",
        "expr": "((infusion_dose * weight) / ((drug_amount / infusate_volume))) if (concentration == 'other') else ((infusion_dose * weight) /((concentration)))"
      },
      {
        "key": "rate_v3",
        "expr": "round(rate_v2, 2)"
      }
    ],

  "compute": {
    "engine": "expr",
    "steps": [
      {
        "key": "w_vol",
        "js_name": "W_Vol",
        "expr": "0.0"
      },
      {
        "key": "l_vol",
        "js_name": "L_Vol",
        "expr": "0.0"
      },
      {
        "key": "d_vol",
        "js_name": "D_Vol",
        "expr": "0.0"
      },
      {
        "key": "aa_vol",
        "js_name": "AA_Vol",
        "expr": "0.0"
      },
      {
        "key": "total_volume",
        "js_name": "Total_Volume",
        "expr": "amino_acids + dextrose + lipids + sterile_water"
      }
    ],
    "outputs": [
      {
        "key": "total_osm",
        "js_name": "Total_Osm",
        "label": "Total Osm",
        "expr": "amino_acids + dextrose + lipids + (1.46 * calcium_chloride) + (1.46 * calcium_gluconate) + (2 * potassium_chloride) + (2 * potassium_acetate) + (2.47 * potassium_phosphate) + magnesium_sulfate + (2 * sodium_chloride) + (2 * sodium_acetate) + (4 * sodium_phosphate)",
        "base_unit": "mOsm",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "total_volume_of_base_solution",
        "js_name": "Total_Volume_of_Base_Solution",
        "label": "Total Volume of Base Solution",
        "expr": "total_volume",
        "base_unit": "mL",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "tpn_osmolarity",
        "js_name": "TPN_Osmolarity",
        "label": "TPN Osmolarity",
        "expr": "1000 * total_osm / total_volume",
        "base_unit": "mOsm/L",
        "units": null,
        "label_source": "printed form"
      }
    ]
  },

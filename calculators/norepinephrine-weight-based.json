  "compute": {
    "engine": "expr",
    "steps": [
      {
        "key": "concentration_calc",
        "expr": "(drug_amount / infusate_volume) if (concentration == \"other\") else (concentration / 1000)"
      },
      {
        "key": "rate",
        "expr": "((dose * weight)*60) / (concentration_calc * 1000)"
      },
      {
        "key": "rate_v2",
        "expr": "round(rate, 2)"
      }
    ],
    "outputs": [

  "compute": {
    "engine": "expr",
    "steps": [],
    "outputs": [
      {
        "key": "score",
        "js_name": "Score",
        "label": "Score",
        "expr": "rectal_temp + map + hr + rr + aa_gradient_or_po2 + ph_or_hco3 + na + k + creat + hct + wbc + glasgow + age + chronic_dx",
        "base_unit": null,
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "log_or",
        "js_name": "Log_OR",
        "label": "Log OR",
        "expr": "-3.517 + (score * 0.146) + post_emerg_surg + admit_dx",
        "base_unit": "number",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "odds_ratio",
        "js_name": "Odds_Ratio",
        "label": "Odds Ratio",
        "expr": "exp(log_or)",
        "base_unit": "ratio",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "mortality",
        "js_name": "Mortality",
        "label": "Mortality",
        "expr": "100 * odds_ratio / ( 1 + odds_ratio )",
        "base_unit": "%",
        "units": null,
        "label_source": "printed form"
      }
    ]
  },

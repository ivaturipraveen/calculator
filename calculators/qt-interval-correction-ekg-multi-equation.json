  },
  "content": {
    "equation": "QT_Interval_Corrected_Bazett = QT_Interval / sqr(RR_interval/1000)\nQT_Interval_Corrected_Fridericia = QT_Interval / (RR_interval/1000)1/3\nQT_Interval_Corrected_Framingham = QT_Interval + (0.154 * (1000 - RR_interval))\nQT_Interval_Corrected_Hodges = QT_Interval + (1.75 * (Heart_rate - 60))",
    "notes": [
      "Heart Rate Measure may be entered as either:",
      "The EKG RR interval in milliseconds of the beat prior to the QT interval.",
      "The EKG heart rate in beats per minute.",
      "EKG: electrocardiogram; BPM: beats per minute."
    ],

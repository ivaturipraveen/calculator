  "compute": {
    "engine": "expr",
    "steps": [
      {
        "key": "heart_rate",
        "js_name": "Heart_rate",
        "expr": "(60000 / rr_interval) if (heart_rate_measure_unit_mode == 1) else ((heart_rate_measure) if (heart_rate_measure_unit_mode == 0) else (60000 / rr_interval))"
      },
      {
        "key": "rr_interval",
        "js_name": "RR_interval",
        "expr": "(heart_rate_measure) if (heart_rate_measure_unit_mode == 1) else ((60000 / heart_rate) if (heart_rate_measure_unit_mode == 0) else (60000 / heart_rate))"
      }
    ],
    "outputs": [
      {
        "key": "heart_rate",
        "js_name": "Heart_Rate",
        "label": "Heart Rate",
        "expr": "heart_rate",
        "base_unit": null,
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "rr_interval",
        "js_name": "RR_Interval",
        "label": "RR Interval",
        "expr": "rr_interval",
        "base_unit": null,
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "qt_interval_corrected_bazett",
        "js_name": "QT_Interval_Corrected_Bazett",
        "label": "QT Interval Corrected Bazett",
        "expr": "qt_interval / sqrt(rr_interval/1000)",
        "base_unit": null,
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "qt_interval_corrected_fridericia",
        "js_name": "QT_Interval_Corrected_Fridericia",
        "label": "QT Interval Corrected Fridericia",
        "expr": "qt_interval / pow((rr_interval/1000), 1/3)",
        "base_unit": null,
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "qt_interval_corrected_framingham",
        "js_name": "QT_Interval_Corrected_Framingham",
        "label": "QT Interval Corrected Framingham",
        "expr": "qt_interval + (0.154 * (1000 - rr_interval))",
        "base_unit": null,
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "qt_interval_corrected_hodges",
        "js_name": "QT_Interval_Corrected_Hodges",
        "label": "QT Interval Corrected Hodges",
        "expr": "qt_interval + (1.75 * (heart_rate - 60))",
        "base_unit": null,
        "units": null,
        "label_source": "printed form"
      }
    ]
  },
  "scoring": null,
  "tables": null,

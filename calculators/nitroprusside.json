  "compute": {
    "engine": "expr",
    "steps": [
      {
        "key": "calculated_concentration",
        "expr": "(drug_amount/infusate_volume) if (concentration == \"other\") else ((concentration) / 1000)"
      },
      {
        "key": "dose_wb",
        "expr": "dose * weight"
      },
      {
        "key": "rate",
        "expr": "(dose_wb * 60) / (1000 * calculated_concentration)"
      },
      {
        "key": "rate_v2",
        "expr": "round(rate, 2)"
      }
    ],
    "outputs": [
      {
        "key": "infuse_rate",
        "label": "Infusion Rate",
        "expr": "rate_v2",
        "decimals": null,
        "base_unit": "mL/hour",
        "kind": "number",
        "label_source": "printed form (position)",
        "unit_source": "formula_prose"
      }
    ]
  },

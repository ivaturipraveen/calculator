  "compute": {
    "engine": "expr",
    "steps": [
      {
        "key": "weight_crcl",
        "js_name": "Weight_CrCl",
        "expr": "(ibw) if (weight >= ibw) else (weight)"
      }
    ],
    "outputs": [
      {
        "key": "ibw",
        "js_name": "IBW",
        "label": "IBW",
        "expr": "abs(height > 60) * (2.3 * (height - 60)) + IBW_Sex",
        "base_unit": "kg",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "dw",
        "js_name": "DW",
        "label": "DW",
        "expr": "(weight) if (weight < ibw) else (abs(weight > (1.2 * ibw)) * (0.4 * (weight - ibw)) + ibw)",
        "base_unit": "kg",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "crcl",
        "js_name": "CrCl",
        "label": "CrCl",
        "expr": "((140 - age) * (weight_crcl / (serum_creat * 72))) * CrCl_Sex",
        "base_unit": "mL/min",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "ke",
        "js_name": "Ke",
        "label": "Ke",
        "expr": "(0.00293 * crcl) + 0.014",
        "base_unit": "hr-1",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "half_life",
        "js_name": "Half_Life",
        "label": "Half Life",
        "expr": "0.693 / ke",
        "base_unit": "hr",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "vd",
        "js_name": "VD",
        "label": "VD",
        "expr": "dw * distribution_factor",
        "base_unit": "L",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "predicted_peak",
        "js_name": "Predicted_Peak",
        "label": "Predicted Peak",
        "expr": "(dose * (1 - exp(-ke * infusion_time))) / (ke * vd * infusion_time * (1 - exp(-ke * dose_interval)))",
        "base_unit": "mg/L",
        "units": null,
        "label_source": "printed form"
      },
      {
        "key": "predicted_trough",
        "js_name": "Predicted_Trough",
        "label": "Predicted Trough",
        "expr": "predicted_peak * exp(-ke * (dose_interval - infusion_time))",
        "base_unit": "mg/L",
        "units": null,
        "label_source": "printed form"
      }
    ]
  },
